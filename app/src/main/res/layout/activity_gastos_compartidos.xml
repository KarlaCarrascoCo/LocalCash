        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" app:cardBackgroundColor="@color/lc_surface" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="@color/lc_sage_outline" app:strokeWidth="1dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/shared_step_one_title" android:textColor="@color/lc_text_primary" android:textStyle="bold" /><com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="@string/shared_description_hint"><com.google.android.material.textfield.TextInputEditText android:id="@+id/input_shared_description" android:layout_width="match_parent" android:layout_height="56dp" android:inputType="textCapSentences" /></com.google.android.material.textfield.TextInputLayout><com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="@string/shared_total_hint" app:prefixText="$ "><com.google.android.material.textfield.TextInputEditText android:id="@+id/input_shared_total" android:layout_width="match_parent" android:layout_height="56dp" android:inputType="number" /></com.google.android.material.textfield.TextInputLayout><com.google.android.material.button.MaterialButton android:id="@+id/button_toggle_shared_detail" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/action_add_shared_detail" android:textColor="@color/lc_green_dark" /><LinearLayout android:id="@+id/container_shared_details" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone"><com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/shared_detail_hint" app:helperText="@string/shared_detail_helper"><com.google.android.material.textfield.TextInputEditText android:id="@+id/input_shared_details" android:layout_width="match_parent" android:layout_height="96dp" android:gravity="top" android:inputType="textMultiLine" /></com.google.android.material.textfield.TextInputLayout></LinearLayout></LinearLayout></com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:cardBackgroundColor="@color/lc_surface" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="@color/lc_sage_outline" app:strokeWidth="1dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/shared_step_two_title" android:textColor="@color/lc_text_primary" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/shared_step_two_description" android:textColor="@color/lc_text_secondary" /><com.google.android.material.button.MaterialButton android:id="@+id/button_select_shared_contacts" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:text="@string/action_select_shared_contacts" /><TextView android:id="@+id/text_shared_contacts" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/shared_contacts_none" android:textColor="@color/lc_text_secondary" /><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal"><com.google.android.material.button.MaterialButton android:id="@+id/button_equal_allocation" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginEnd="4dp" android:layout_weight="1" android:text="@string/action_equal_allocation" /><com.google.android.material.button.MaterialButton android:id="@+id/button_custom_allocation" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="4dp" android:layout_weight="1" android:text="@string/action_custom_allocation" /></LinearLayout><TextView android:id="@+id/text_shared_distribution" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/shared_distribution_equal" android:textColor="@color/lc_text_secondary" /></LinearLayout></com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton android:id="@+id/button_add_shared" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="14dp" android:text="@string/action_review_shared" app:backgroundTint="@color/lc_orange_earth" />
