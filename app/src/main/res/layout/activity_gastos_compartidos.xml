        <LinearLayout android:id="@+id/container_shared_debts" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:orientation="horizontal"><com.google.android.material.button.MaterialButton android:id="@+id/button_filter_shared_pending" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginEnd="4dp" android:layout_weight="1" android:text="@string/shared_filter_pending" /><com.google.android.material.button.MaterialButton android:id="@+id/button_filter_shared_paid" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="4dp" android:layout_weight="1" android:text="@string/shared_filter_paid" /></LinearLayout><LinearLayout android:id="@+id/list_shared" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" /></LinearLayout>
