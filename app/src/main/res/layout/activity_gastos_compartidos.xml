<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lc_warm_background"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView style="@style/TextAppearance.Material3.HeadlineMedium" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/shared_title" android:textColor="@color/lc_green_dark" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/shared_subtitle" android:textColor="@color/lc_text_secondary" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_select_shared_contacts" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="20dp" android:text="@string/action_select_shared_contacts" />
        <TextView android:id="@+id/text_shared_contacts" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/shared_contacts_none" android:textColor="@color/lc_text_secondary" />
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="@string/shared_description_hint">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/input_shared_description" android:layout_width="match_parent" android:layout_height="56dp" android:inputType="textCapSentences" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="@string/shared_total_hint" app:prefixText="$ ">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/input_shared_total" android:layout_width="match_parent" android:layout_height="56dp" android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="@string/shared_detail_hint" app:helperText="@string/shared_detail_helper">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/input_shared_details" android:layout_width="match_parent" android:layout_height="96dp" android:gravity="top" android:inputType="textMultiLine" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/button_custom_allocation" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:text="@string/action_custom_allocation" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_add_shared" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="16dp" android:text="@string/action_split_expense" app:backgroundTint="@color/lc_orange_earth" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/shared_debts_title" android:textColor="@color/lc_text_primary" android:textSize="18sp" android:textStyle="bold" />
        <LinearLayout android:id="@+id/list_shared" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
