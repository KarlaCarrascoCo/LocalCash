<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/lc_warm_background">
    <ScrollView android:layout_width="0dp" android:layout_height="0dp" android:clipToPadding="false" android:paddingStart="16dp" android:paddingTop="14dp" android:paddingEnd="16dp" android:paddingBottom="20dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/history_bottom_navigation" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/history_title" android:textColor="@color/lc_green_dark" android:textSize="25sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/history_subtitle" android:textColor="@color/lc_text_secondary" android:textSize="12sp" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/button_history_back" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/action_back" android:textAllCaps="false" android:textColor="@color/lc_green_dark" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="@string/history_type_label" android:textColor="@color/lc_text_primary" android:textSize="14sp" android:textStyle="bold" />
            <com.google.android.material.button.MaterialButtonToggleGroup android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:checkedButton="@id/button_history_filter_all" app:selectionRequired="true" app:singleSelection="true">
                <com.google.android.material.button.MaterialButton android:id="@+id/button_history_filter_all" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="@string/movement_filter_all" android:textSize="11sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/button_history_filter_income" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="@string/movement_filter_income" android:textSize="11sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/button_history_filter_expense" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="@string/movement_filter_expense" android:textSize="11sp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
            <LinearLayout android:id="@+id/list_history" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:id="@+id/history_bottom_navigation" android:layout_width="0dp" android:layout_height="68dp" android:background="@color/lc_surface" android:elevation="8dp" android:gravity="center" android:orientation="horizontal" android:paddingStart="4dp" android:paddingEnd="4dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <com.google.android.material.button.MaterialButton android:id="@+id/button_history_nav_home" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:text="@string/nav_home" android:textAllCaps="false" android:textColor="@color/lc_nav_unselected" android:textSize="11sp" app:icon="@drawable/ic_home" app:iconGravity="textTop" app:iconPadding="2dp" app:iconTint="@color/lc_nav_unselected" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_history_nav_history" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:text="@string/nav_movements" android:textAllCaps="false" android:textColor="@color/lc_green_dark" android:textSize="11sp" app:icon="@drawable/ic_history" app:iconGravity="textTop" app:iconPadding="2dp" app:iconTint="@color/lc_green_dark" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_history_nav_shopping" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:text="@string/nav_shopping" android:textAllCaps="false" android:textColor="@color/lc_nav_unselected" android:textSize="11sp" app:icon="@drawable/ic_cart" app:iconGravity="textTop" app:iconPadding="2dp" app:iconTint="@color/lc_nav_unselected" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_history_nav_more" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:text="@string/nav_more" android:textAllCaps="false" android:textColor="@color/lc_nav_unselected" android:textSize="11sp" app:icon="@drawable/ic_more" app:iconGravity="textTop" app:iconPadding="2dp" app:iconTint="@color/lc_nav_unselected" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
