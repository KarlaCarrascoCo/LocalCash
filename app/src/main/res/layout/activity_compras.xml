<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/lc_warm_background">
    <ScrollView android:layout_width="0dp" android:layout_height="0dp" android:fillViewport="true" android:clipToPadding="false" android:paddingStart="16dp" android:paddingTop="14dp" android:paddingEnd="16dp" android:paddingBottom="20dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/shopping_bottom_navigation" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView style="@style/TextAppearance.Material3.HeadlineMedium" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/shopping_title" android:textColor="@color/lc_green_dark" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/shopping_subtitle" android:textColor="@color/lc_text_secondary" android:textSize="12sp" />
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:hint="@string/shopping_name_hint"><com.google.android.material.textfield.TextInputEditText android:id="@+id/input_shopping_name" android:layout_width="match_parent" android:layout_height="56dp" android:inputType="textCapSentences" /></com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="@string/shopping_quantity_hint"><com.google.android.material.textfield.TextInputEditText android:id="@+id/input_shopping_quantity" android:layout_width="match_parent" android:layout_height="56dp" android:inputType="number" /></com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="@string/shopping_price_hint" app:prefixText="$ "><com.google.android.material.textfield.TextInputEditText android:id="@+id/input_shopping_price" android:layout_width="match_parent" android:layout_height="56dp" android:inputType="number" /></com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/button_add_shopping" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="14dp" android:text="@string/action_add_shopping" app:backgroundTint="@color/lc_orange_earth" app:cornerRadius="18dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="@string/shopping_history_title" android:textColor="@color/lc_text_primary" android:textSize="18sp" android:textStyle="bold" />
            <LinearLayout android:id="@+id/list_shopping" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:id="@+id/shopping_bottom_navigation" android:layout_width="0dp" android:layout_height="68dp" android:background="@color/lc_surface" android:elevation="8dp" android:gravity="center" android:orientation="horizontal" android:paddingStart="4dp" android:paddingEnd="4dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <com.google.android.material.button.MaterialButton android:id="@+id/button_shopping_nav_home" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:text="@string/nav_home" android:textAllCaps="false" android:textColor="@color/lc_nav_unselected" android:textSize="11sp" app:icon="@drawable/ic_home" app:iconGravity="textTop" app:iconPadding="2dp" app:iconTint="@color/lc_nav_unselected" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_shopping_nav_history" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:text="@string/nav_movements" android:textAllCaps="false" android:textColor="@color/lc_nav_unselected" android:textSize="11sp" app:icon="@drawable/ic_history" app:iconGravity="textTop" app:iconPadding="2dp" app:iconTint="@color/lc_nav_unselected" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_shopping_nav_shopping" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:text="@string/nav_shopping" android:textAllCaps="false" android:textColor="@color/lc_green_dark" android:textSize="11sp" app:icon="@drawable/ic_cart" app:iconGravity="textTop" app:iconPadding="2dp" app:iconTint="@color/lc_green_dark" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_shopping_nav_more" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:text="@string/nav_more" android:textAllCaps="false" android:textColor="@color/lc_nav_unselected" android:textSize="11sp" app:icon="@drawable/ic_more" app:iconGravity="textTop" app:iconPadding="2dp" app:iconTint="@color/lc_nav_unselected" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
