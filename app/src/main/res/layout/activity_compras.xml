<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/lc_warm_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView style="@style/TextAppearance.Material3.HeadlineMedium" android:text="@string/shopping_title" android:textColor="@color/lc_green_dark" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/shopping_subtitle" android:textColor="@color/lc_text_secondary" />
        <EditText android:id="@+id/input_shopping_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:hint="@string/shopping_name_hint" android:inputType="textCapSentences" />
        <EditText android:id="@+id/input_shopping_quantity" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/shopping_quantity_hint" android:inputType="number" />
        <EditText android:id="@+id/input_shopping_price" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/shopping_price_hint" android:inputType="number" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_add_shopping" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/action_add_shopping" app:backgroundTint="@color/lc_orange_earth" xmlns:app="http://schemas.android.com/apk/res-auto" />
        <LinearLayout android:id="@+id/list_shopping" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
