<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/lc_warm_background" android:padding="16dp">
    <TextView android:id="@+id/text_picker_title" style="@style/TextAppearance.Material3.HeadlineSmall" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/location_picker_title" android:textColor="@color/lc_green_dark" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <TextView android:id="@+id/text_selected_coordinates" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/location_picker_instruction" android:textColor="@color/lc_text_secondary" android:textSize="12sp" app:layout_constraintTop_toBottomOf="@id/text_picker_title" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <FrameLayout android:id="@+id/location_picker_map_container" android:layout_width="0dp" android:layout_height="0dp" android:layout_marginTop="12dp" android:background="@color/lc_surface" app:layout_constraintTop_toBottomOf="@id/text_selected_coordinates" app:layout_constraintBottom_toTopOf="@id/location_picker_actions" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:id="@+id/layout_picker_loading" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical"><ProgressBar android:id="@+id/progress_picker_loading" android:layout_width="40dp" android:layout_height="40dp" /><com.google.android.material.button.MaterialButton android:id="@+id/button_retry_picker_map" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginTop="12dp" android:text="@string/action_retry_map" android:visibility="gone" /></LinearLayout>
    </FrameLayout>
    <LinearLayout android:id="@+id/location_picker_actions" android:layout_width="0dp" android:layout_height="56dp" android:layout_marginTop="12dp" android:gravity="end" android:orientation="horizontal" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"><com.google.android.material.button.MaterialButton android:id="@+id/button_cancel_location" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="@string/action_cancel" android:textColor="@color/lc_green_dark" /><com.google.android.material.button.MaterialButton android:id="@+id/button_confirm_location" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginStart="8dp" android:text="@string/action_confirm_location" app:backgroundTint="@color/lc_orange_earth" app:cornerRadius="16dp" /></LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
